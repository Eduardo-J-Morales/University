                    val = o[key];

                    if (isArray(val)) {
                        copy[key] = val.slice();
                    } else if (isObject(val, true)) {
                        i = arrayIndex(known, val);

                        copy[key] = i === -1 ? copyObj(val) : knownCopies[i];
