jQuery(document).ready(function(){jQuery("a").on("click",function(){var t=jQuery(this).attr("href"),a={utm_pais:"",utm_producto:"",utm_subproducto:""};if(t.search("utm_pais")>=0){jQuery(this).text();var u=jQuery(this).attr("href");digitalData.page.pageActivity.link={url:u};for(var r=t.split("?"),i=1;i<r.length;i++)for(var e=r[i].split("&"),c=0;c<e.length;c++)e[c].search("utm_pais")>=0?a.utm_pais=e[c].replace("utm_pais=",""):e[c].search("utm_producto")>=0?a.utm_producto=e[c].replace("utm_producto=",""):e[c].search("utm_subproducto")>=0&&(a.utm_subproducto=e[c].replace("utm_subproducto=",""));actualizarDigitalData("",a),digitalLink("External Link",digitalData)}})});