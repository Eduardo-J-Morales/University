<svg viewBox="0 0 1600 900" version="1.1" preserveAspectRatio="xMinYMin meet" text-rendering="geometricPrecision" class="p3" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><defs><style type="text/css">text{white-space:pre;font-size:16px;font-weight:normal;font-style:normal;fill:none;unicode-bidi:bidi-override}@font-face{font-family:"p3_g_d0_f1";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p3_g_d0_f2";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p3_g_d0_f3";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}.p3 .ff1{font-family:"p3_g_d0_f1",sans-serif;line-height:1}.p3 .ff2{font-family:"p3_g_d0_f3",sans-serif;line-height:1}.p3 .ff3{font-family:"p3_g_d0_f2",sans-serif;line-height:1}.p3 .fs1{font-size:18.666666px}.p3 .fs3{font-size:17.333334px}.p3 .fc1{fill:#262626}.p3 .fc2{fill:#000000}.p3 .sc1{stroke:none}</style></defs><image width="1600" height="900" preserveAspectRatio="none" xlink:href="data:image/jpeg;base64,"></image><text class="ff1 fs1 fc1" transform="matrix(1.67 0 0 1.67 687.03 93.14)" textLength="176.47">Tabla de contenido</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 285.61)" textLength="115.25">Introducción</text><text class="ff3 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.57 328.94)" textLength="15.55">1.</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 328.94)" textLength="451.75">Sistema Globalmente Armonizado Clasificación y </text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 372.27)" textLength="375.87">etiquetado de Productos Químicos (SGA)</text><text class="ff3 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.57 415.61)" textLength="15.55">2.</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 415.61)" textLength="498.25">Comportamientos seguros que se deben tener para el </text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 458.94)" textLength="340.16">almacenamiento seguro de químicos</text><text class="ff3 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.57 502.27)" textLength="15.55">3.</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 502.27)" textLength="233.33">Matriz de compatibilidad </text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.66 545.61)" dx="0 0 24.01">4.Ficha de Seguridad</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.66 588.94)" dx="0 0 24.01">5.Etiquetado</text><text class="ff3 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.57 632.27)" textLength="15.55">6.</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 632.27)" textLength="316.23">Elementos de protección personal </text><text class="ff3 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.57 675.61)" textLength="15.55">7.</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 675.61)" textLength="421.68">Importancia de los elementos de Emergencias</text><text class="ff3 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.57 718.94)" textLength="15.55">8.</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 718.94)" textLength="119.77">Conclusiones</text><text class="ff3 fs1 fc2" transform="matrix(1.67 0 0 1.67 351.57 762.27)" textLength="15.55">9.</text><text class="ff2 fs1 fc2" transform="matrix(1.67 0 0 1.67 417.50 762.27)" textLength="237.94">Referencias bibliográficas </text></svg>